# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Cloud mode (Anthropic) ────────────────────────────────────────────────────
# Required when LOCAL_MODE is not set or false.
ANTHROPIC_API_KEY=your_key_here

# ── Local mode (free, runs on your PC via Ollama) ────────────────────────────
# Set LOCAL_MODE=true to run Oracle and SOV1 completely free with local models.
# Requires Ollama installed and running: https://ollama.com
#
# Setup steps:
#   1. Install Ollama from https://ollama.com
#   2. Pull a text model:   ollama pull qwen2.5:7b
#   3. Pull a vision model: ollama pull qwen2.5-vl:7b   (for SOV1 screen control)
#   4. Set LOCAL_MODE=true below and restart Oracle.
#
# LOCAL_MODE=true
# LOCAL_MODEL=qwen2.5:7b
# LOCAL_MODEL_VISION=qwen2.5-vl:7b
# OLLAMA_BASE=http://localhost:11434/v1
