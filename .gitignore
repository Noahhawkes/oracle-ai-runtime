# Logs
Logs/
*.log

# Local secrets
.env
*.key
*.pem

# OS/system files
.DS_Store
Thumbs.db
desktop.ini

# Node/Python artifacts
node_modules/
__pycache__/
*.pyc

# Runtime data
Memory/
*.db

# Approval gate runtime output — live pending candidate data, may contain
# sensitive rendered context awaiting human approval. Must stay local.
Projects/pending_candidates/

# OAuth credentials and tokens — must never be committed
storage/token.json
storage/credentials.json
storage/*.json

# User identity and personal documents (privacy — reviewed separately)
Users/

# PyInstaller build artifacts
dist/
build/
*.spec.bak

# Temporary files
*.tmp
*.bak
