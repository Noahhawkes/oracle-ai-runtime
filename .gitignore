# Logs
Logs/
*.log

# Local secrets
.env
*.key
*.pem

# OS/system files
.DS_Store
Thumbs.db
desktop.ini

# Node/Python artifacts
node_modules/
__pycache__/
*.pyc

# Runtime data
Memory/
*.db

# Approval gate runtime output — live pending candidate data, may contain
# sensitive rendered context awaiting human approval. Must stay local.
Projects/pending_candidates/

# Daemon runtime proposals — generated output, not source. Stays local.
Projects/daemon_proposals/
Oracle_Daemon_Proposal.md
goals.txt
core/Desktop/

# OAuth credentials and tokens — must never be committed
storage/token.json
storage/credentials.json
storage/*.json

# User identity and personal documents (privacy — reviewed separately)
Users/

# PyInstaller build artifacts
dist/
build/
*.spec.bak

# Temporary files
*.tmp
*.bak

# Raw thread exports — never commit raw conversation text
thread_exports/

# Local AI bridge/message logs - runtime coordination, not source
Messages/*.md

# Raise-Hand Protocol runtime queue and ledger
state/
.snapshots/
