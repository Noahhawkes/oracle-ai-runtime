<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>ORACLE.AI</string>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>ORACLE.AI connects to Noah's private ORACLE server on the local network.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>ORACLE.AI uses the microphone so you can speak directly to ORACLE.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>ORACLE.AI transcribes your voice so it can be sent to the ORACLE server.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <!-- Tailscale IPs (100.x.x.x) are not treated as local by ATS.
             Remove NSAllowsArbitraryLoads once TLS is added to the server. -->
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
